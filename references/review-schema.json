{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://romanjo.art/schemas/review-1.0.json",
  "title": "Romanjo Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "image", "summary", "saliency", "gaze_path", "depth", "composition", "color", "motion", "narrative", "generation_guidance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "image": {"$ref": "#/$defs/image"},
    "summary": {"$ref": "#/$defs/summary"},
    "saliency": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/saliencyPoint"}},
    "gaze_path": {"$ref": "#/$defs/gazePath"},
    "depth": {"$ref": "#/$defs/depth"},
    "composition": {"$ref": "#/$defs/composition"},
    "color": {"$ref": "#/$defs/color"},
    "motion": {"$ref": "#/$defs/motion"},
    "narrative": {"$ref": "#/$defs/narrative"},
    "generation_guidance": {"$ref": "#/$defs/guidance"}
  },
  "$defs": {
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "point": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"$ref": "#/$defs/unit"}, "y": {"$ref": "#/$defs/unit"}}},
    "image": {"type": "object", "additionalProperties": false, "required": ["source", "width", "height", "alt"], "properties": {"source": {"type": "string", "minLength": 1}, "width": {"type": ["integer", "null"], "minimum": 1}, "height": {"type": ["integer", "null"], "minimum": 1}, "alt": {"type": "string", "minLength": 1}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["one_line", "strengths", "risks", "confidence"], "properties": {"one_line": {"type": "string", "minLength": 1}, "strengths": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 1}}, "risks": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1}}, "confidence": {"$ref": "#/$defs/unit"}}},
    "saliencyPoint": {"type": "object", "additionalProperties": false, "required": ["id", "rank", "center", "radius", "weight", "drivers", "evidence", "confidence"], "properties": {"id": {"type": "string", "pattern": "^s[1-8]$"}, "rank": {"type": "integer", "minimum": 1, "maximum": 8}, "center": {"$ref": "#/$defs/point"}, "radius": {"type": "number", "minimum": 0.01, "maximum": 0.6}, "weight": {"$ref": "#/$defs/unit"}, "drivers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["contrast", "luminance", "saturation", "detail", "isolation", "scale", "face", "text", "leading-line", "semantic-distinctiveness"]}}, "evidence": {"type": "string", "minLength": 1}, "confidence": {"$ref": "#/$defs/unit"}}},
    "gazePath": {"type": "object", "additionalProperties": false, "required": ["point_ids", "curve", "duration_ms", "interpretation"], "properties": {"point_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^s[1-8]$"}}, "curve": {"enum": ["smooth", "angular", "radial", "looping", "scattered"]}, "duration_ms": {"type": "integer", "minimum": 500, "maximum": 30000}, "interpretation": {"type": "string", "minLength": 1}}},
    "polygon": {"type": "array", "minItems": 3, "maxItems": 24, "items": {"$ref": "#/$defs/point"}},
    "depthRegion": {"type": "object", "additionalProperties": false, "required": ["id", "label", "band", "depth_order", "polygon", "edge_softness", "confidence"], "properties": {"id": {"type": "string", "pattern": "^d[1-9][0-9]*$"}, "label": {"type": "string", "minLength": 1}, "band": {"enum": ["near", "mid", "far", "unknown"]}, "depth_order": {"type": "integer", "minimum": 1}, "polygon": {"$ref": "#/$defs/polygon"}, "edge_softness": {"$ref": "#/$defs/unit"}, "confidence": {"$ref": "#/$defs/unit"}}},
    "depth": {"type": "object", "additionalProperties": false, "required": ["method", "regions", "cues", "confidence"], "properties": {"method": {"const": "semantic-object-regions"}, "regions": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/depthRegion"}}, "cues": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["occlusion", "relative-scale", "perspective", "atmospheric", "focus", "shading", "vertical-position", "texture-gradient"]}}, "confidence": {"$ref": "#/$defs/unit"}}},
    "line": {"type": "object", "additionalProperties": false, "required": ["start", "end", "role", "confidence"], "properties": {"start": {"$ref": "#/$defs/point"}, "end": {"$ref": "#/$defs/point"}, "role": {"enum": ["leading", "horizon", "axis", "frame", "diagonal", "rhythm"]}, "confidence": {"$ref": "#/$defs/unit"}}},
    "spiral": {"type": ["object", "null"], "additionalProperties": false, "required": ["pole", "rotation", "scale", "anchor_label", "confidence"], "properties": {"pole": {"$ref": "#/$defs/point"}, "rotation": {"enum": ["clockwise", "counterclockwise"]}, "scale": {"type": "number", "minimum": 0.1, "maximum": 2}, "anchor_label": {"type": "string", "minLength": 1}, "confidence": {"$ref": "#/$defs/unit"}}},
    "composition": {"type": "object", "additionalProperties": false, "required": ["layout", "balance", "anchors", "structural_lines", "golden_spiral", "interpretation"], "properties": {"layout": {"enum": ["central", "rule-of-thirds", "diagonal", "triangular", "radial", "symmetrical", "asymmetrical", "layered", "all-over", "mixed"]}, "balance": {"enum": ["stable", "dynamic", "tense", "top-heavy", "bottom-heavy", "left-heavy", "right-heavy"]}, "anchors": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["label", "position"], "properties": {"label": {"type": "string", "minLength": 1}, "position": {"$ref": "#/$defs/point"}}}}, "structural_lines": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/line"}}, "golden_spiral": {"$ref": "#/$defs/spiral"}, "interpretation": {"type": "string", "minLength": 1}}},
    "histogram": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/unit"}},
    "paletteItem": {"type": "object", "additionalProperties": false, "required": ["hex", "weight", "role"], "properties": {"hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}, "weight": {"$ref": "#/$defs/unit"}, "role": {"enum": ["dominant", "support", "accent", "highlight", "shadow", "neutral"]}}},
    "color": {"type": "object", "additionalProperties": false, "required": ["measurement", "palette", "histogram", "contrast", "temperature", "interpretation"], "properties": {"measurement": {"enum": ["pixel-measured", "visually-estimated"]}, "palette": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/paletteItem"}}, "histogram": {"type": "object", "additionalProperties": false, "required": ["luminance", "red", "green", "blue"], "properties": {"luminance": {"$ref": "#/$defs/histogram"}, "red": {"$ref": "#/$defs/histogram"}, "green": {"$ref": "#/$defs/histogram"}, "blue": {"$ref": "#/$defs/histogram"}}}, "contrast": {"enum": ["low", "medium", "high", "mixed"]}, "temperature": {"enum": ["cool", "neutral", "warm", "mixed"]}, "interpretation": {"type": "string", "minLength": 1}}},
    "motion": {"type": "object", "additionalProperties": false, "required": ["energy", "directions", "rhythm", "evidence"], "properties": {"energy": {"$ref": "#/$defs/unit"}, "directions": {"type": "array", "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "strength"], "properties": {"from": {"$ref": "#/$defs/point"}, "to": {"$ref": "#/$defs/point"}, "strength": {"$ref": "#/$defs/unit"}}}}, "rhythm": {"enum": ["still", "flowing", "pulsed", "accelerating", "chaotic", "cyclical"]}, "evidence": {"type": "string", "minLength": 1}}},
    "narrative": {"type": "object", "additionalProperties": false, "required": ["visible_content", "story_reading", "mood_keywords", "ambiguities"], "properties": {"visible_content": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 1}}, "story_reading": {"type": "string", "minLength": 1}, "mood_keywords": {"type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "ambiguities": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 1}}}},
    "guidanceItem": {"type": "object", "additionalProperties": false, "required": ["priority", "action", "target", "expected_effect"], "properties": {"priority": {"enum": ["high", "medium", "low"]}, "action": {"enum": ["preserve", "increase", "reduce", "move", "clarify", "remove", "add"]}, "target": {"type": "string", "minLength": 1}, "expected_effect": {"type": "string", "minLength": 1}}},
    "guidance": {"type": "object", "additionalProperties": false, "required": ["preserve", "change", "negative_constraints"], "properties": {"preserve": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/guidanceItem"}}, "change": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/guidanceItem"}}, "negative_constraints": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1}}}}
  }
}
